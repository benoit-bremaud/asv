{
  "name": "asv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:web": "vite",
    "dev:server": "tsx watch src/transports/node/main.ts",
    "tester": "pnpm build && ASV_TUNNEL=1 ASV_STATIC_ROOT=dist tsx src/transports/node/main.ts",
    "mod:invite": "tsx src/transports/node/owner-cli-main.ts invite",
    "mod:revoke": "tsx src/transports/node/owner-cli-main.ts revoke",
    "mod:filed": "tsx src/transports/node/owner-cli-main.ts filed",
    "cf:deploy:staging": "pnpm build && wrangler deploy --env staging",
    "cf:deploy:production": "pnpm build && wrangler deploy --env production",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "sonar": "test -z \"$(git status --porcelain)\" && pnpm test:coverage && { sonar-scanner; scripts/sonar-status.sh; }",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.160.1"
  }
}
